# Which backend to use: "ollama" (any Ollama server) or "groq" (hosted)
LLM_BACKEND=ollama

# --- Ollama -----------------------------------------------------------------
# RunPod GPU instance. Use the base URL WITHOUT the /v1 suffix - this talks the
# native Ollama API, which lets us set num_ctx (the /v1 layer does not).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# For a local box instead:
# OLLAMA_URL=http://localhost:11434

# --- Groq (used when LLM_BACKEND=groq) --------------------------------------
GROQ_API_KEY=gsk_your_key_here
# Groq has retired Llama 3.1; available chat models are openai/gpt-oss-120b,
# openai/gpt-oss-20b, qwen/qwen3.6-27b, groq/compound.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_URL=https://api.groq.com/openai/v1
# Groq free tier meters 8000 tokens/minute - keep each request small
GROQ_MAX_RESUME_CHARS=12000
